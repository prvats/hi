{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hi",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  // Preview URLs are extra public hostnames that bypass the Access app.
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hi",
      "database_id": "a2ea3505-0253-431d-b88e-2a0c531e4236"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        // 30 chat requests per minute, per user, per Cloudflare location.
        "limit": 30,
        "period": 60
      }
    }
  ]
}
